# buoy — Environment Configuration Example
# Copy this file to .env and adjust values.

# Logging
# BUOY_LOG_LEVEL=info
# BUOY_LOG_FORMAT=json

# Restic — Global password (fallback for all repos)
# BUOY_RESTIC_PASSWORD=your-secure-password

# Restic — Per-repo configuration via environment variables
# Pattern: BUOY_RESTIC_REPO_<NAME>_URL and BUOY_RESTIC_REPO_<NAME>_PASSWORD
# Example for a local repo named "local":
# BUOY_RESTIC_REPO_LOCAL_URL=/backup
# BUOY_RESTIC_REPO_LOCAL_PASSWORD=local-repo-password

# Example for an S3 repo named "s3":
# BUOY_RESTIC_REPO_S3_URL=s3:https://s3.amazonaws.com/my-bucket
# BUOY_RESTIC_REPO_S3_PASSWORD=s3-repo-password

# Daemon
# BUOY_DAEMON_CONCURRENCY=2
# BUOY_DAEMON_DEFAULT_SCHEDULE=@daily

# API
# BUOY_API_TOKEN=my-secret-token

# Notifications (shoutrrr URLs)
# BUOY_NOTIFY_URLS=slack://tokenA/tokenB/tokenC
# BUOY_NOTIFY_LEVEL=error

# OpenTelemetry — gated on OTEL_EXPORTER_OTLP_ENDPOINT being set
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc                # grpc or http/protobuf
# OTEL_SERVICE_NAME=buoy                          # defaults to "buoy"
# OTEL_RESOURCE_ATTRIBUTES=host.name=my-host      # used in Grafana dashboard host selector
