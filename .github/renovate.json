{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":automergeMinor", ":automergeDigest"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["depado/github-actions"],
      "pinDigests": false
    },
    {
      "matchManagers": ["docker", "docker-compose", "dockerfile"],
      "matchPackageNames": ["ghcr.io/depado/buoy", "depado/buoy"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": ["ARG RESTIC_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "restic/restic",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": ["ARG RCLONE_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rclone/rclone",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
